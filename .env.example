# Copy to .env and fill in real values, then see docker-compose.yml for how to run each sample.
# Values below are placeholders, not real credentials.
ENVISO_API_KEY=your-api-key-here

# Multi-line values (like a PEM public key) must be quoted, or docker compose's .env
# parser will choke on the continuation lines — keep this quoting when you fill in the
# real key.
ENVISO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
your-base64-encoded-public-key-here
-----END PUBLIC KEY-----"
ENVISO_TENANT_SECRET=your-tenant-secret-here
ENVISO_BASE_URL=https://api.staging-enviso.io/

# python/run.py posts to a full URL rather than base+path like the other samples.
ENVISO_LOGIN_URL=https://api.staging-enviso.io/authenticationapi/v1/login/
